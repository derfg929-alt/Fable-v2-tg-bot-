# Telegram Bot Token от @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Хранилище данных. По умолчанию используется локальный SQLite-файл, а все данные
# дополнительно сохраняются в JSON (data/bot_database.json) — PostgreSQL не нужен.
# DATABASE_URL=sqlite+aiosqlite:///data/bot_database.db
# Для PostgreSQL раскомментируйте строку ниже (нужен драйвер postgresql+asyncpg):
# DATABASE_URL=postgresql+asyncpg://fable:fable@localhost:5432/fable

# Путь к JSON-базе (по умолчанию data/bot_database.json). "-" отключает JSON-синхронизацию.
JSON_DATABASE_PATH=data/bot_database.json

# Telegram ID владельца бота (для глобального администрирования)
OWNER_ID=8039111975

# Fable Randomizer: username бота и адрес Mini App.
# Если BOT_USERNAME пуст, бот определит его автоматически через Telegram API при запуске.
BOT_USERNAME=
MINI_APP_URL=

# Серверный API и Mini App (проверка initData, конкурсы, история).
API_HOST=0.0.0.0
API_PORT=8080
# Срок жизни подписи Telegram initData в секундах (0 — не проверять).
INITDATA_TTL_SECONDS=86400

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Часовой пояс бота
TIMEZONE=Europe/Moscow

# Настройки нейросети: xAI Grok (приоритет) или Groq Cloud (бесплатная альтернатива).
# Приоритет отдаётся Grok, если задан GROK_API_KEY; иначе используется Groq.
# Ключ ищется в этом файле, затем в переменных окружения. Работает и без ключей —
# тогда бот отвечает встроенным офлайн-движком Fable.

# Вариант 1 (xAI Grok — вставьте GROK_API_KEY, получить на https://console.x.ai):
GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_MODEL=grok-4.7

# Вариант 2 (Groq Cloud — вставьте GROQ_API_KEY, получить на https://console.groq.com):
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
