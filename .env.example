# Telegram Bot Token от @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# URL подключения к PostgreSQL (требуется драйвер postgresql+asyncpg)
DATABASE_URL=postgresql+asyncpg://fable:fable@localhost:5432/fable

# Telegram ID владельца бота (для глобального администрирования)
OWNER_ID=8039111975

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Часовой пояс бота
TIMEZONE=Europe/Moscow

# Настройки нейросети: Groq Cloud API (быстрый бесплатный ИИ) или Grok AI (xAI)
# Вариант 1 (Groq Cloud - вставьте GROQ_API_KEY):
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b

# Вариант 2 (xAI Grok - вставьте GROK_API_KEY):
