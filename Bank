"""Банковские операции и суточное начисление процентов.

Ставки и порядок начисления соответствуют ТЗ Fable:
- до 10 000 монет включительно — 5%;
- свыше 10 000 до 50 000 включительно — 3%;
- свыше 50 000 до 100 000 включительно — 1,5%;
- свыше 100 000 — 0,5%.

Границы в ТЗ частично пересекаются (10 000, 50 000 и 100 000), поэтому
в реализации нижняя ступень включает граничное значение.

Все суммы — целые монеты. Дробная часть ежедневного процента отбрасывается
вниз. Сервис не выполняет commit: транзакцией управляет вызывающий код.
"""
from __future__ import annotations

from dataclasses import dataclass
from datetime import date, datetime, time, timezone
from decimal import Decimal, ROUND_DOWN
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError

from sqlalchemy import select
from sqlalchemy.dialects.postgresql import insert
from sqlalchemy.ext.asyncio import AsyncSession

from app.config import get_settings
from app.db.models import BankInterestRun, EconomyTransaction, Player
from app.services.economy_service import (
    EconomyResult,
    InsufficientFundsError,
    InvalidAmountError,
    PlayerNotFoundError,
)


class BankError(Exception):
    """Базовая ошибка банковских операций."""


class InsufficientBankFundsError(BankError):
    """На банковском счёте недостаточно монет."""


@dataclass(frozen=True, slots=True)
class BankOperationResult:
    player_id: int
    wallet_balance: int
    bank_balance: int
    amount: int
    operation: str
    transaction: EconomyTransaction | None = None
    duplicate: bool = False


@dataclass(frozen=True, slots=True)
class InterestResult:
    player_id: int
    period: datetime
    principal: int
    rate: Decimal
    interest: int
    applied: bool


def _validate_amount(amount: int) -> None:
    if isinstance(amount, bool) or not isinstance(amount, int) or amount <= 0:
        raise InvalidAmountError("Сумма должна быть целым числом больше нуля")


def get_interest_rate(balance: int) -> Decimal:
    """Возвращает суточную ставку по размеру вклада до начисления."""
    if balance < 0:
        raise ValueError("Банковский баланс не может быть отрицательным")
    if balance <= 10_000:
        return Decimal("0.05")
    if balance <= 50_000:
        return Decimal("0.03")
    if balance <= 100_000:
        return Decimal("0.015")
    return Decimal("0.005")


def _period_start(value: datetime | date | None = None) -> datetime:
    """Начало суточного периода в настроенной зоне, представленное в UTC."""
    settings = get_settings()
    try:
        zone = ZoneInfo(settings.timezone)
    except ZoneInfoNotFoundError as exc:
        raise ValueError(f"Неизвестная временная зона: {settings.timezone}") from exc

    if value is None:
        local_now = datetime.now(zone)
        local_midnight = datetime.combine(local_now.date(), time.min, tzinfo=zone)
    elif isinstance(value, datetime):
        if value.tzinfo is None:
            raise ValueError("period должен содержать часовой пояс")
        local_value = value.astimezone(zone)
        local_midnight = datetime.combine(local_value.date(), time.min, tzinfo=zone)
    else:
        local_midnight = datetime.combine(value, time.min, tzinfo=zone)

    return local_midnight.astimezone(timezone.utc)


async def _lock_player(session: AsyncSession, user_id: int) -> Player:
    if user_id <= 0:
        raise ValueError("Telegram ID должен быть положительным")
    player = await session.scalar(
        select(Player)
        .where(Player.telegram_id == user_id)
        .with_for_update()
    )
    if player is None:
        raise PlayerNotFoundError(f"Игрок Telegram ID {user_id} не найден")
    return player


async def _write_bank_ledger(
    session: AsyncSession,
    *,
    user_id: int,
    amount: int,
    operation_type: str,
    wallet_delta: int,
    bank_delta: int,
    reason: str,
    idempotency_key: str | None,
) -> tuple[EconomyTransaction | None, EconomyTransaction | None]:
    values = {
        "operation_type": operation_type,
        "amount": amount,
        "actor_id": user_id,
        "recipient_id": user_id,
        "fee": 0,
        "actor_balance_delta": wallet_delta,
        "recipient_balance_delta": bank_delta,
        "reason": reason,
        "reference": None,
        "idempotency_key": idempotency_key,
        "metadata_json": {"wallet_delta": wallet_delta, "bank_delta": bank_delta},
    }
    statement = insert(EconomyTransaction).values(**values)
    if idempotency_key:
        statement = statement.on_conflict_do_nothing(
            index_elements=[EconomyTransaction.idempotency_key]
        )
    transaction_id = (
        await session.execute(statement.returning(EconomyTransaction.id))
    ).scalar_one_or_none()

    if transaction_id is not None:
        transaction = await session.get(EconomyTransaction, transaction_id)
        if transaction is None:
            raise RuntimeError("Не удалось прочитать созданную банковскую операцию")
        return transaction, None

    if not idempotency_key:
        raise RuntimeError("Не удалось записать банковскую операцию")
    duplicate = await session.scalar(
        select(EconomyTransaction).where(
            EconomyTransaction.idempotency_key == idempotency_key
        )
    )
    if duplicate is None:
        raise RuntimeError("Конфликт ключа банковской операции без записи")
    return None, duplicate


async def deposit(
    session: AsyncSession,
    *,
    user_id: int,
    amount: int,
    idempotency_key: str | None = None,
) -> BankOperationResult:
    """Перемещает монеты из кошелька на банковский счёт."""
    _validate_amount(amount)
    player = await _lock_player(session, user_id)

    if idempotency_key:
        existing = await session.scalar(
            select(EconomyTransaction).where(
                EconomyTransaction.idempotency_key == idempotency_key
            )
        )
        if existing is not None:
            return BankOperationResult(
                user_id, player.wallet, player.bank_balance, amount,
                "deposit", existing, True
            )

    if player.wallet < amount:
        raise InsufficientFundsError(
            f"В кошельке {player.wallet} монет, требуется {amount}"
        )

    transaction, duplicate = await _write_bank_ledger(
        session,
        user_id=user_id,
        amount=amount,
        operation_type="bank_deposit",
        wallet_delta=-amount,
        bank_delta=amount,
        reason="Пополнение банковского счёта",
        idempotency_key=idempotency_key,
    )
    if duplicate is not None:
        return BankOperationResult(
            user_id, player.wallet, player.bank_balance, amount,
            "deposit", duplicate, True
        )

    player.wallet -= amount
    player.bank_balance += amount
    return BankOperationResult(
        user_id, player.wallet, player.bank_balance, amount, "deposit", transaction
    )


async def withdraw(
    session: AsyncSession,
    *,
    user_id: int,
    amount: int,
    idempotency_key: str | None = None,
) -> BankOperationResult:
    """Перемещает монеты с банковского счёта в кошелёк."""
    _validate_amount(amount)
    player = await _lock_player(session, user_id)

    if idempotency_key:
        existing = await session.scalar(
            select(EconomyTransaction).where(
                EconomyTransaction.idempotency_key == idempotency_key
            )
        )
        if existing is not None:
            return BankOperationResult(
                user_id, player.wallet, player.bank_balance, amount,
                "withdraw", existing, True
            )

    if player.bank_balance < amount:
        raise InsufficientBankFundsError(
            f"В банке {player.bank_balance} монет, требуется {amount}"
        )

    transaction, duplicate = await _write_bank_ledger(
        session,
        user_id=user_id,
        amount=amount,
        operation_type="bank_withdraw",
        wallet_delta=amount,
        bank_delta=-amount,
        reason="Снятие с банковского счёта",
        idempotency_key=idempotency_key,
    )
    if duplicate is not None:
        return BankOperationResult(
            user_id, player.wallet, player.bank_balance, amount,
            "withdraw", duplicate, True
        )

    player.bank_balance -= amount
    player.wallet += amount
    return BankOperationResult(
        user_id, player.wallet, player.bank_balance, amount, "withdraw", transaction
    )


async def get_bank_status(
    session: AsyncSession, *, user_id: int
) -> dict[str, int | Decimal | datetime | None]:
    """Данные для команды «банк»: балансы, ставка и последнее начисление."""
    player = await session.get(Player, user_id)
    if player is None:
        raise PlayerNotFoundError(f"Игрок Telegram ID {user_id} не найден")

    last_run = await session.scalar(
        select(BankInterestRun)
        .where(BankInterestRun.user_id == user_id)
        .order_by(BankInterestRun.period_date.desc())
        .limit(1)
    )
    current_period = _period_start()
    settings = get_settings()
    zone = ZoneInfo(settings.timezone)
    next_period = (
        current_period.replace(tzinfo=timezone.utc).astimezone(zone).date()
    )
    from datetime import timedelta
    next_local_midnight = datetime.combine(
        next_period + timedelta(days=1), time.min, tzinfo=zone
    )
    next_interest_at = next_local_midnight.astimezone(timezone.utc)

    return {
        "wallet_balance": player.wallet,
        "bank_balance": player.bank_balance,
        "interest_rate": get_interest_rate(player.bank_balance),
        "last_interest_at": last_run.created_at if last_run else None,
        "last_interest_period": last_run.period_date if last_run else None,
        "next_interest_at": next_interest_at,
    }


async def accrue_interest_for_player(
    session: AsyncSession,
    *,
    user_id: int,
    period: datetime | date | None = None,
) -> InterestResult:
    """Начисляет проценты одному игроку не более одного раза за сутки."""
    period_start = _period_start(period)
    player = await _lock_player(session, user_id)
    principal = player.bank_balance
    rate = get_interest_rate(principal)
    interest = int(
        (Decimal(principal) * rate).to_integral_value(rounding=ROUND_DOWN)
    )

    # Уникальность (user_id, period_date) — последняя линия защиты от дублей.
    run_id = (
        await session.execute(
            insert(BankInterestRun)
            .values(
                user_id=user_id,
                period_date=period_start,
                principal=principal,
                rate=rate,
                interest=interest,
            )
            .on_conflict_do_nothing(
                index_elements=[
                    BankInterestRun.user_id,
                    BankInterestRun.period_date,
                ]
            )
            .returning(BankInterestRun.id)
        )
    ).scalar_one_or_none()

    if run_id is None:
        return InterestResult(
            user_id, period_start, principal, rate, 0, applied=False
        )

    if interest > 0:
        ledger = EconomyTransaction(
            operation_type="bank_interest",
            amount=interest,
            actor_id=None,
            recipient_id=user_id,
            fee=0,
            actor_balance_delta=0,
            recipient_balance_delta=interest,
            reason="Ежедневные проценты по банковскому вкладу",
            reference=f"bank-interest:{user_id}:{period_start.isoformat()}",
            idempotency_key=f"bank-interest:{user_id}:{period_start.date().isoformat()}",
            metadata_json={
                "principal": principal,
                "rate": str(rate),
                "period": period_start.isoformat(),
            },
        )
        session.add(ledger)
        player.bank_balance += interest

    return InterestResult(
        user_id, period_start, principal, rate, interest, applied=True
    )


async def accrue_daily_interest(
    session: AsyncSession,
    *,
    period: datetime | date | None = None,
    batch_size: int = 500,
) -> list[InterestResult]:
    """Начисляет проценты всем игрокам пакетами.

    Функцию следует запускать планировщиком раз в сутки. SELECT FOR UPDATE
    SKIP LOCKED позволяет нескольким экземплярам бота разделить работу.
    Для повторного запуска за тот же период уникальный ключ не даст начислить
    проценты повторно.
    """
    if batch_size < 1 or batch_size > 5000:
        raise ValueError("batch_size должен быть в диапазоне 1..5000")

    period_start = _period_start(period)
    results: list[InterestResult] = []
    last_id = 0

    while True:
        players = (
            await session.execute(
                select(Player)
                .where(Player.telegram_id > last_id)
                .order_by(Player.telegram_id)
                .limit(batch_size)
                .with_for_update(skip_locked=True)
            )
        ).scalars().all()

        if not players:
            break

        for player in players:
            last_id = max(last_id, player.telegram_id)
            principal = player.bank_balance
            rate = get_interest_rate(principal)
            interest = int(
                (Decimal(principal) * rate).to_integral_value(rounding=ROUND_DOWN)
            )
            run_id = (
                await session.execute(
                    insert(BankInterestRun)
                    .values(
                        user_id=player.telegram_id,
                        period_date=period_start,
                        principal=principal,
                        rate=rate,
                        interest=interest,
                    )
                    .on_conflict_do_nothing(
                        index_elements=[
                            BankInterestRun.user_id,
                            BankInterestRun.period_date,
                        ]
                    )
                    .returning(BankInterestRun.id)
                )
            ).scalar_one_or_none()

            if run_id is None:
                results.append(
                    InterestResult(
                        player.telegram_id, period_start, principal, rate, 0, False
                    )
                )
                continue

            if interest > 0:
                session.add(
                    EconomyTransaction(
                        operation_type="bank_interest",
                        amount=interest,
                        actor_id=None,
                        recipient_id=player.telegram_id,
                        fee=0,
                        actor_balance_delta=0,
                        recipient_balance_delta=interest,
                        reason="Ежедневные проценты по банковскому вкладу",
                        reference=f"bank-interest:{player.telegram_id}:{period_start.isoformat()}",
                        idempotency_key=(
                            f"bank-interest:{player.telegram_id}:"
                            f"{period_start.date().isoformat()}"
                        ),
                        metadata_json={
                            "principal": principal,
                            "rate": str(rate),
                            "period": period_start.isoformat(),
                        },
                    )
                )
                player.bank_balance += interest

            results.append(
                InterestResult(
                    player.telegram_id, period_start, principal, rate,
                    interest, True
                )
            )

        # Данные остаются в текущей транзакции до commit вызывающего кода.
        # Последний ID гарантирует продвижение курсора даже при SKIP LOCKED.

    return results
