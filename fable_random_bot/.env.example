# Токен от @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram ID администраторов бота (через запятую). На создание конкурсов не
# влияет — конкурсы может создавать любой пользователь. Необязательно.
ADMIN_IDS=111222333,444555666

# Постоянная папка данных. На Bothost это /app/data (сохраняется между
# перезапусками). Файл базы — $DATA_DIR/database.json.
DATA_DIR=/app/data

# Часовой пояс планировщика
TIMEZONE=Europe/Moscow
